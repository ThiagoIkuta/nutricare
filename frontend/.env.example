# ─── NutriCare Frontend — Variáveis de Ambiente ──────────────────────────────
# Copie este arquivo para .env e ajuste se necessário.

# URL base da API do backend (sem barra no final)
# Em desenvolvimento, o backend roda em http://localhost:8000
VITE_API_URL=http://localhost:8000/api/v1

# URL do projeto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública anon (Settings → API → anon public) — segura para expor no frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Como rodar ────────────────────────────────────────────────────────────────
# npm install
# npm run dev
# Acesse em: http://localhost:5173
